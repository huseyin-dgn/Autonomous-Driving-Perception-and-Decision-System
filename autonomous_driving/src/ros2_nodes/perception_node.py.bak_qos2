    def get_component_info(self, mask):
        mask = mask.astype("uint8")
        num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(mask, connectivity=8)

        if num_labels <= 1:
            return {
                "area": 0,
                "x": 0,
                "y": 0,
                "w": 0,
                "h": 0,
                "touches_border": False,
            }

        best = {
            "area": 0,
            "x": 0,
            "y": 0,
            "w": 0,
            "h": 0,
            "touches_border": False,
        }

        H, W = mask.shape[:2]

        for i in range(1, num_labels):
            x, y, w, h, area = stats[i]

            if int(area) > best["area"]:
                touches_border = (
                    x <= 1 or
                    y <= 1 or
                    x + w >= W - 2 or
                    y + h >= H - 2
                )

                best = {
                    "area": int(area),
                    "x": int(x),
                    "y": int(y),
                    "w": int(w),
                    "h": int(h),
                    "touches_border": bool(touches_border),
                }

        return best

    def classify_traffic_light_hsv_strict(self, frame, bbox):
        frame_h, frame_w = frame.shape[:2]

        x1, y1, x2, y2 = [int(v) for v in bbox]

        x1 = max(0, min(frame_w - 1, x1))
        y1 = max(0, min(frame_h - 1, y1))
        x2 = max(0, min(frame_w - 1, x2))
        y2 = max(0, min(frame_h - 1, y2))

        bw = max(1, x2 - x1)
        bh = max(1, y2 - y1)
        area = bw * bh

        scores = {
            "red": 0,
            "yellow": 0,
            "green": 0,
        }

        if bw < 10 or bh < 18 or area < 180:
            return "unknown", scores, f"too_small:bw={bw},bh={bh},area={area}"

        crop = frame[y1:y2, x1:x2]

        if crop.size == 0:
            return "unknown", scores, "empty_crop"

        crop = cv2.resize(crop, (60, 120), interpolation=cv2.INTER_LINEAR)

        hsv = cv2.cvtColor(crop, cv2.COLOR_BGR2HSV)

        h = hsv[:, :, 0]
        s = hsv[:, :, 1]
        v = hsv[:, :, 2]

        red_mask = (
            (((h >= 0) & (h <= 12)) | ((h >= 168) & (h <= 179))) &
            (s >= 80) &
            (v >= 100)
        )

        yellow_mask = (
            (h >= 18) &
            (h <= 38) &
            (s >= 90) &
            (v >= 130)
        )

        green_mask = (
            (h >= 42) &
            (h <= 95) &
            (s >= 60) &
            (v >= 80)
        )

        H = crop.shape[0]

        top = slice(0, int(H * 0.40))
        mid = slice(int(H * 0.30), int(H * 0.72))
        bot = slice(int(H * 0.60), H)

        red_region = red_mask[top, :]
        yellow_region = yellow_mask[mid, :]
        green_region = green_mask[bot, :]

        red_score = int(red_region.sum())
        yellow_score = int(yellow_region.sum())
        green_score = int(green_region.sum())

        scores = {
            "red": red_score,
            "yellow": yellow_score,
            "green": green_score,
        }

        total = red_score + yellow_score + green_score

        if total < 20:
            return "unknown", scores, f"not_enough_signal:{total}"

        red_comp = self.get_component_info(red_region)
        yellow_comp = self.get_component_info(yellow_region)
        green_comp = self.get_component_info(green_region)

        best_color = max(scores, key=scores.get)
        best_score = scores[best_color]

        sorted_scores = sorted(scores.items(), key=lambda x: x[1], reverse=True)
        second_score = sorted_scores[1][1]

        if best_score < 18:
            return "unknown", scores, f"best_too_low:{best_score}"

        if second_score > 0 and best_score < second_score * 1.6:
            return "unknown", scores, f"not_dominant:best={best_score},second={second_score}"

        if red_score >= 18 and red_comp["area"] >= 10 and red_score >= yellow_score * 0.45:
            return "red", scores, "red_region_priority"

        if best_color == "yellow":
            if yellow_score < 45:
                return "unknown", scores, f"yellow_weak:{yellow_score}"

            if yellow_comp["area"] < 15:
                return "unknown", scores, f"yellow_component_too_small:{yellow_comp['area']}"

            if yellow_comp["touches_border"]:
                return "unknown", scores, "yellow_touches_border_probably_body_or_backside"

            yellow_region_area = max(1, yellow_region.shape[0] * yellow_region.shape[1])
            yellow_ratio = yellow_comp["area"] / yellow_region_area

            if yellow_ratio > 0.35:
                return "unknown", scores, f"yellow_area_too_large_probably_body:{yellow_ratio:.3f}"

        if best_color == "green":
            if green_score < 20:
                return "unknown", scores, f"green_weak:{green_score}"

            if green_comp["area"] < 10:
                return "unknown", scores, f"green_component_too_small:{green_comp['area']}"

        if best_color == "red":
            if red_score < 18:
                return "unknown", scores, f"red_weak:{red_score}"

            if red_comp["area"] < 10:
                return "unknown", scores, f"red_component_too_small:{red_comp['area']}"

        return best_color, scores, "region_hsv_ok"

    def classify_traffic_light_state_model(self, frame, bbox):
        if not self.tl_state_ready or self.tl_state_model is None or self.tl_state_transform is None:
            return None

        frame_h, frame_w = frame.shape[:2]
        x1, y1, x2, y2 = [int(v) for v in bbox]

        x1 = max(0, min(frame_w - 1, x1))
        y1 = max(0, min(frame_h - 1, y1))
        x2 = max(0, min(frame_w - 1, x2))
        y2 = max(0, min(frame_h - 1, y2))

        bw = max(1, x2 - x1)
        bh = max(1, y2 - y1)

        if bw < 4 or bh < 4:
            return {
                "state": "unknown",
                "confidence": 0.0,
                "probs": {},
                "reason": f"classifier_too_small:bw={bw},bh={bh}",
            }

        pad_x = int(bw * 0.08)
        pad_y = int(bh * 0.08)

        cx1 = max(0, x1 - pad_x)
        cy1 = max(0, y1 - pad_y)
        cx2 = min(frame_w - 1, x2 + pad_x)
        cy2 = min(frame_h - 1, y2 + pad_y)

        crop = frame[cy1:cy2, cx1:cx2]

        if crop.size == 0:
            return {
                "state": "unknown",
                "confidence": 0.0,
                "probs": {},
                "reason": "classifier_empty_crop",
            }

        rgb = cv2.cvtColor(crop, cv2.COLOR_BGR2RGB)
        pil_img = PILImage.fromarray(rgb)

        x = self.tl_state_transform(pil_img)
        x = x.unsqueeze(0).to(self.tl_state_device)

        with torch.no_grad():
            logits = self.tl_state_model(x)
            prob_tensor = torch.softmax(logits, dim=1)[0].detach().cpu()

        probs = {}
        for i, name in enumerate(self.tl_state_class_names):
            probs[str(name)] = float(prob_tensor[i].item())

        idx = int(torch.argmax(prob_tensor).item())
        state = str(self.tl_state_class_names[idx])
        confidence = float(prob_tensor[idx].item())

        if state not in ["red", "yellow", "green", "unknown"]:
            state = "unknown"

        return {
            "state": state,
            "confidence": confidence,
            "probs": probs,
            "reason": f"classifier_pred:{state}:{confidence:.3f}",
        }

    def classify_traffic_light_state(self, frame, bbox):
        hsv_state, hsv_scores, hsv_reason = self.classify_traffic_light_hsv_strict(frame, bbox)

        result = {
            "state": hsv_state,
            "source": "hsv_strict",
            "state_confidence": None,
            "classifier_probs": {},
            "classifier_reason": "classifier_not_used",
            "hsv_state": hsv_state,
            "hsv_scores": hsv_scores,
            "hsv_reason": hsv_reason,
            "final_reason": hsv_reason,
        }

        if not self.tl_state_classifier_enabled:
            return result

        if not self.tl_state_ready:
            if self.tl_state_use_hsv_fallback:
                result["source"] = "hsv_fallback_classifier_not_ready"
                result["final_reason"] = f"classifier_not_ready;hsv={hsv_state}:{hsv_reason}"
                return result

            result["state"] = "unknown"
            result["source"] = "classifier_not_ready_no_fallback"
            result["final_reason"] = "classifier_not_ready_no_fallback"
            return result

        try:
            cls_result = self.classify_traffic_light_state_model(frame, bbox)
        except Exception as exc:
            if self.tl_state_use_hsv_fallback:
                result["source"] = "hsv_fallback_classifier_error"
                result["classifier_reason"] = f"classifier_error:{exc}"
                result["final_reason"] = f"classifier_error:{exc};hsv={hsv_state}:{hsv_reason}"
                return result

            result["state"] = "unknown"
            result["source"] = "classifier_error_no_fallback"
            result["classifier_reason"] = f"classifier_error:{exc}"
            result["final_reason"] = f"classifier_error:{exc}"
            return result

        if cls_result is None:
            if self.tl_state_use_hsv_fallback:
                result["source"] = "hsv_fallback_classifier_none"
                result["final_reason"] = f"classifier_none;hsv={hsv_state}:{hsv_reason}"
                return result

            result["state"] = "unknown"
            result["source"] = "classifier_none_no_fallback"
            result["final_reason"] = "classifier_none_no_fallback"
            return result

        cls_state = cls_result.get("state", "unknown")
        cls_conf = float(cls_result.get("confidence", 0.0))
        cls_probs = cls_result.get("probs", {})
        cls_reason = cls_result.get("reason", "-")

        result["state_confidence"] = cls_conf
        result["classifier_probs"] = cls_probs
        result["classifier_reason"] = cls_reason

        if cls_conf < self.tl_state_conf_threshold:
            result["state"] = "unknown"
            result["source"] = "classifier_low_conf"
            result["final_reason"] = (
                f"classifier_low_conf:pred={cls_state},conf={cls_conf:.3f},"
                f"thr={self.tl_state_conf_threshold:.3f};hsv={hsv_state}:{hsv_reason}"
            )
            return result

        if cls_state == "unknown":
            result["state"] = "unknown"
            result["source"] = "classifier_unknown"
            result["final_reason"] = (
                f"classifier_unknown:conf={cls_conf:.3f};hsv={hsv_state}:{hsv_reason}"
            )
            return result

        result["state"] = cls_state
        result["source"] = "classifier"
        result["final_reason"] = (
            f"classifier_ok:state={cls_state},conf={cls_conf:.3f};hsv={hsv_state}:{hsv_reason}"
        )
        return result

    def is_vehicle(self, label):
        return label == "vehicle"

    def is_person(self, label):
        return label == "person"

    def is_motorcycle(self, label):
        return label == "motorcycle"

    def is_traffic_light(self, label):
        return label == "traffic_light"

    def is_traffic_sign(self, label):
        return label == "traffic_sign"




    def get_tl_state_confidence(self, det):
        for key in [
            "traffic_light_state_confidence",
            "tl_state_confidence",
            "state_confidence",
            "state_conf",
            "classifier_confidence",
        ]:
            value = det.get(key, None)
            if value is not None:
                try:
                    return float(value)
                except Exception:
                    pass

        probs = det.get("traffic_light_state_probs", None)
        state = det.get("traffic_light_state", "unknown")

        if isinstance(probs, dict) and state in probs:
            try:
                return float(probs[state])
            except Exception:
                pass

        return 0.0

    def choose_active_traffic_light(self, detections, frame_w, frame_h, frame=None):
        lights = []

        for d in detections:
            if d.get("label") != "traffic_light":
                continue

            if frame is not None:
                if not self.normalize_or_drop_traffic_light_lens(frame, d):
                    continue

            state = str(d.get("traffic_light_state", "unknown")).lower().strip()
            if state == "unknown" and self.tl_env_bool_safe("TL_DROP_UNKNOWN_LIGHTS", True):
                continue

            lights.append(d)

        if not lights:
            return None

        red_priority = self.tl_env_bool_safe("TL_RED_PRIORITY", True)

        known_states = {"red", "yellow", "green"}
        candidates = []

        for det in lights:
            state = str(det.get("traffic_light_state", "unknown")).lower().strip()
            state_conf = self.get_tl_state_confidence(det)
            det_conf = float(det.get("confidence", 0.0))

            x1, y1, x2, y2 = [float(v) for v in det.get("bbox", [0, 0, 0, 0])]
            bw = max(1.0, x2 - x1)
            bh = max(1.0, y2 - y1)
            area = bw * bh
            cx = (x1 + x2) / 2.0

            center_score = 1.0 - min(1.0, abs(cx - frame_w * 0.5) / max(1.0, frame_w * 0.5))

            if red_priority:
                state_priority = {
                    "red": 3,
                    "yellow": 2,
                    "green": 1,
                    "unknown": 0,
                }.get(state, 0)
            else:
                state_priority = {
                    "red": 1,
                    "yellow": 1,
                    "green": 1,
                    "unknown": 0,
                }.get(state, 0)

            score = (
                1 if state in known_states else 0,
                state_priority,
                state_conf,
                det_conf,
                area,
                center_score,
            )

            candidates.append((score, det))

        if not candidates:
            return None

        return sorted(candidates, key=lambda item: item[0], reverse=True)[0][1]

    def _tl_env_float(self, name, default):
        try:
            return float(env_float(name, default))
        except Exception:
            return float(default)

    def _tl_env_bool(self, name, default):
        try:
            return bool(env_bool(name, default))
        except Exception:
            v = str(os.environ.get(name, str(int(default)))).lower().strip()
            return v in ("1", "true", "yes", "on")

    def _traffic_light_lens_hsv_state(self, frame, bbox):
        import cv2
        import numpy as np

        if frame is None or bbox is None or len(bbox) != 4:
            return "unknown", 0.0, {}, "bad_input"

        h_img, w_img = frame.shape[:2]

        x1, y1, x2, y2 = [float(v) for v in bbox]
        x1 = int(max(0, min(w_img - 1, x1)))
        y1 = int(max(0, min(h_img - 1, y1)))
        x2 = int(max(0, min(w_img, x2)))
        y2 = int(max(0, min(h_img, y2)))

        bw = x2 - x1
        bh = y2 - y1
        area = bw * bh

        min_w = self._tl_env_float("TL_LENS_MIN_W", 10)
        min_h = self._tl_env_float("TL_LENS_MIN_H", 20)
        min_area = self._tl_env_float("TL_LENS_MIN_AREA", 120)

        if bw < min_w or bh < min_h or area < min_area:
            return "unknown", 0.0, {}, f"bbox_too_small:bw={bw},bh={bh},area={area}"

        crop = frame[y1:y2, x1:x2].copy()
        if crop.size == 0:
            return "unknown", 0.0, {}, "empty_crop"

        ch, cw = crop.shape[:2]

        mx = int(max(1, cw * self._tl_env_float("TL_LENS_MARGIN_X", 0.08)))
        my = int(max(1, ch * self._tl_env_float("TL_LENS_MARGIN_Y", 0.06)))

        inner = crop[my:max(my + 1, ch - my), mx:max(mx + 1, cw - mx)]
        if inner.size == 0:
            inner = crop

        ih, iw = inner.shape[:2]

        hsv_dark = cv2.cvtColor(inner, cv2.COLOR_BGR2HSV)
        s_ch = hsv_dark[:, :, 1]
        v_ch = hsv_dark[:, :, 2]

        dark_mask = (((v_ch < 95) & (s_ch < 170)) | (v_ch < 55)).astype("uint8") * 255

        kernel = np.ones((3, 3), dtype="uint8")
        dark_mask = cv2.morphologyEx(dark_mask, cv2.MORPH_CLOSE, kernel, iterations=1)
        dark_mask = cv2.morphologyEx(dark_mask, cv2.MORPH_OPEN, kernel, iterations=1)

        contours, _ = cv2.findContours(dark_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

        panel = None
        best_score = 0.0
        panel_box = None

        for c in contours:
            px, py, pw, ph = cv2.boundingRect(c)
            if pw <= 2 or ph <= 5:
                continue

            p_area = pw * ph
            aspect = ph / max(1.0, pw)

            if p_area < max(12.0, 0.015 * iw * ih):
                continue

            if aspect < 1.15:
                continue

            score = p_area * min(aspect, 6.0)

            if score > best_score:
                best_score = score
                panel_box = (px, py, pw, ph)

        require_panel = self._tl_env_bool("TL_LENS_REQUIRE_DARK_PANEL", True)

        if panel_box is None:
            if require_panel:
                return "unknown", 0.0, {}, "no_dark_lens_panel"
            panel = inner
        else:
            px, py, pw, ph = panel_box

            expand_x = int(max(1, pw * 0.20))
            expand_y = int(max(1, ph * 0.08))

            ax1 = max(0, px - expand_x)
            ay1 = max(0, py - expand_y)
            ax2 = min(iw, px + pw + expand_x)
            ay2 = min(ih, py + ph + expand_y)

            panel = inner[ay1:ay2, ax1:ax2]

        if panel is None or panel.size == 0:
            return "unknown", 0.0, {}, "empty_panel"

        ph, pw = panel.shape[:2]

        if pw < 3 or ph < 9:
            return "unknown", 0.0, {}, f"panel_too_small:pw={pw},ph={ph}"

        def compute_color_scores(img, code):
            hsv = cv2.cvtColor(img, code)
            H = hsv[:, :, 0]
            S = hsv[:, :, 1]
            V = hsv[:, :, 2]

            red_mask = (((H <= 10) | (H >= 170)) & (S >= 80) & (V >= 120))
            yellow_mask = ((H >= 15) & (H <= 38) & (S >= 70) & (V >= 130))
            green_mask = ((H >= 40) & (H <= 95) & (S >= 60) & (V >= 100))

            return red_mask, yellow_mask, green_mask

        red_bgr, yellow_bgr, green_bgr = compute_color_scores(panel, cv2.COLOR_BGR2HSV)
        red_rgb, yellow_rgb, green_rgb = compute_color_scores(panel, cv2.COLOR_RGB2HSV)

        bgr_strength = int(red_bgr.sum()) + int(yellow_bgr.sum()) + int(green_bgr.sum())
        rgb_strength = int(red_rgb.sum()) + int(yellow_rgb.sum()) + int(green_rgb.sum())

        if rgb_strength > bgr_strength:
            red_mask, yellow_mask, green_mask = red_rgb, yellow_rgb, green_rgb
            color_space = "rgb"
        else:
            red_mask, yellow_mask, green_mask = red_bgr, yellow_bgr, green_bgr
            color_space = "bgr"

        third1 = int(ph / 3)
        third2 = int(2 * ph / 3)

        zones = {
            "red": red_mask[0:third1, :],
            "yellow": yellow_mask[third1:third2, :],
            "green": green_mask[third2:ph, :],
        }

        zone_area = max(1, zones["red"].size)

        scores = {
            "red": float(zones["red"].sum()) / float(zone_area),
            "yellow": float(zones["yellow"].sum()) / float(zone_area),
            "green": float(zones["green"].sum()) / float(zone_area),
        }

        best_state = max(scores, key=scores.get)
        best_value = scores[best_state]

        min_ratio = self._tl_env_float("TL_LENS_MIN_COLOR_RATIO", 0.006)
        min_gap = self._tl_env_float("TL_LENS_MIN_SCORE_GAP", 0.002)

        ordered = sorted(scores.items(), key=lambda x: x[1], reverse=True)
        gap = ordered[0][1] - ordered[1][1] if len(ordered) >= 2 else ordered[0][1]

        if best_value < min_ratio:
            return "unknown", 0.0, scores, (
                f"no_lit_lens:best={best_state},score={best_value:.5f},"
                f"panel={pw}x{ph},space={color_space}"
            )

        if gap < min_gap:
            return "unknown", 0.0, scores, (
                f"ambiguous_lens:best={best_state},score={best_value:.5f},gap={gap:.5f},"
                f"panel={pw}x{ph},space={color_space}"
            )

        conf = min(1.0, best_value / max(min_ratio * 8.0, 1e-6))

        return best_state, float(conf), scores, (
            f"lens_hsv_ok:state={best_state},score={best_value:.5f},gap={gap:.5f},"
            f"panel={pw}x{ph},space={color_space}"
        )

    def apply_lens_hsv_to_traffic_lights(self, frame, detections):
        if not detections:
            return detections

        use_lens = self._tl_env_bool("TL_LENS_HSV_ENABLED", True)
        if not use_lens:
            return detections

        drop_unknown = self._tl_env_bool("TL_LENS_DROP_UNKNOWN", True)
        strict_lens = self._tl_env_bool("TL_LENS_STRICT", True)

        kept = []
        dropped_reasons = []

        for det in detections:
            if det.get("label") != "traffic_light":
                kept.append(det)
                continue

            old_state = str(det.get("traffic_light_state", "unknown")).lower().strip()
            old_conf = det.get("traffic_light_state_confidence", det.get("state_confidence", 0.0))
            old_reason = str(det.get("traffic_light_color_reason", det.get("reason", "")))

            lens_state, lens_conf, lens_scores, lens_reason = self._traffic_light_lens_hsv_state(
                frame,
                det.get("bbox", None),
            )

            det["traffic_light_lens_state"] = lens_state
            det["traffic_light_lens_confidence"] = float(lens_conf)
            det["traffic_light_lens_scores"] = lens_scores
            det["traffic_light_lens_reason"] = lens_reason

            if lens_state != "unknown":
                det["traffic_light_state"] = lens_state
                det["traffic_light_state_confidence"] = float(lens_conf)
                det["state_confidence"] = float(lens_conf)
                det["traffic_light_state_source"] = "lens_hsv"
                det["state_source"] = "lens_hsv"
                det["traffic_light_color_reason"] = lens_reason
                kept.append(det)
                continue

            if strict_lens:
                det["traffic_light_state"] = "unknown"
                det["traffic_light_state_confidence"] = 0.0
                det["state_confidence"] = 0.0
                det["traffic_light_state_source"] = "lens_hsv_unknown"
                det["state_source"] = "lens_hsv_unknown"
                det["traffic_light_color_reason"] = (
                    f"lens_unknown:{lens_reason};old_state={old_state};old_conf={old_conf};old_reason={old_reason}"
                )

                if drop_unknown:
                    dropped_reasons.append(det["traffic_light_color_reason"][:220])
                    continue

                kept.append(det)
                continue

            if old_state == "yellow" and "yellow_touches_border_probably_body_or_backside" in old_reason:
                det["traffic_light_state"] = "unknown"
                det["traffic_light_state_confidence"] = 0.0
                det["state_confidence"] = 0.0
                det["traffic_light_state_source"] = "lens_reject_yellow_body"
                det["state_source"] = "lens_reject_yellow_body"
                det["traffic_light_color_reason"] = (
                    f"yellow_body_rejected_by_lens:{lens_reason};old_reason={old_reason}"
                )

                if drop_unknown:
                    dropped_reasons.append(det["traffic_light_color_reason"][:220])
                    continue

            kept.append(det)

        if dropped_reasons:
            self.get_logger().info(
                f"DROP_TRAFFIC_LIGHT_LENS_UNKNOWN count={len(dropped_reasons)} reasons={dropped_reasons[:3]}",
                throttle_duration_sec=0.7,
            )

        detections[:] = kept
        return detections


    def is_bad_carla_yellow_body_light(self, det):
        if not isinstance(det, dict):
            return False

        if det.get("label") != "traffic_light":
            return False

        try:
            enabled = env_bool("TL_REJECT_CARLA_YELLOW_BODY", True)
        except Exception:
            import os
            enabled = str(os.environ.get("TL_REJECT_CARLA_YELLOW_BODY", "1")).lower().strip() in ("1", "true", "yes", "on")

        if not enabled:
            return False

        fields = [
            det.get("traffic_light_color_reason"),
            det.get("traffic_light_lens_reason"),
            det.get("traffic_light_original_reason"),
            det.get("reason"),
            det.get("state_source"),
            det.get("traffic_light_state_source"),
        ]

        text = " ".join(str(x).lower() for x in fields if x is not None)

        bad_tokens = [
            "yellow_touches_border_probably_body_or_backside",
            "yellow_body_reject",
            "yellow_body_rejected",
            "lens_unknown:no_dark_lens_panel",
            "no_dark_lens_panel",
        ]

        if any(t in text for t in bad_tokens):
            return True

        state = str(det.get("traffic_light_state", "unknown")).lower().strip()

        scores = (
            det.get("traffic_light_color_scores")
            or det.get("traffic_light_lens_scores")
            or det.get("hsv_scores")
            or {}
        )

        if isinstance(scores, dict):
            try:
                red = float(scores.get("red", 0.0))
                yellow = float(scores.get("yellow", 0.0))
                green = float(scores.get("green", 0.0))
            except Exception:
                red, yellow, green = 0.0, 0.0, 0.0

            # CARLA'nın sarı kasası: sarı piksel çok yüksek, kırmızı/yeşil neredeyse yok.
            if state == "yellow" and yellow >= 800 and red <= 40 and green <= 40:
                return True

        return False


    def tl_env_bool_safe(self, name, default=False):
        try:
            return env_bool(name, default)
        except Exception:
            import os
            v = str(os.environ.get(name, str(int(default)))).lower().strip()
            return v in ("1", "true", "yes", "on")

    def tl_env_float_safe(self, name, default=0.0):
        try:
            return float(env_float(name, default))
        except Exception:
            import os
            try:
                return float(os.environ.get(name, default))
            except Exception:
                return float(default)

    def tl_largest_components(self, mask, min_area=1):
        import cv2
        import numpy as np

        if mask is None:
            return []

        m = mask.astype("uint8")
        if m.max() <= 1:
            m = m * 255

        n, labels, stats, centroids = cv2.connectedComponentsWithStats(m, 8)
        comps = []

        for i in range(1, n):
            x, y, w, h, area = stats[i]
            if area < min_area:
                continue

            cx, cy = centroids[i]
            comps.append({
                "x": float(x),
                "y": float(y),
                "w": float(w),
                "h": float(h),
                "area": float(area),
                "cx": float(cx),
                "cy": float(cy),
            })

        comps.sort(key=lambda c: c["area"], reverse=True)
        return comps

    def validate_traffic_light_front_lens(self, frame, det):
        import cv2
        import numpy as np

        if frame is None:
            return {
                "valid": False,
                "state": "unknown",
                "confidence": 0.0,
                "reason": "no_frame",
            }

        if not isinstance(det, dict):
            return {
                "valid": False,
                "state": "unknown",
                "confidence": 0.0,
                "reason": "bad_det",
            }

        if det.get("label") != "traffic_light":
            return {
                "valid": True,
                "state": "unknown",
                "confidence": 0.0,
                "reason": "not_traffic_light",
            }

        bbox = det.get("bbox", None)
        if not bbox or len(bbox) != 4:
            return {
                "valid": False,
                "state": "unknown",
                "confidence": 0.0,
                "reason": "no_bbox",
            }

        H, W = frame.shape[:2]
        x1, y1, x2, y2 = [float(v) for v in bbox]

        bw = max(1.0, x2 - x1)
        bh = max(1.0, y2 - y1)
        area = bw * bh
        aspect = bh / bw

        min_w = self.tl_env_float_safe("TL_FRONT_MIN_W", 8.0)
        min_h = self.tl_env_float_safe("TL_FRONT_MIN_H", 18.0)
        min_area = self.tl_env_float_safe("TL_FRONT_MIN_AREA", 120.0)
        min_aspect = self.tl_env_float_safe("TL_FRONT_MIN_ASPECT", 1.20)
        max_aspect = self.tl_env_float_safe("TL_FRONT_MAX_ASPECT", 5.50)

        if bw < min_w or bh < min_h or area < min_area:
            return {
                "valid": False,
                "state": "unknown",
                "confidence": 0.0,
                "reason": f"too_small:bw={bw:.1f},bh={bh:.1f},area={area:.1f}",
            }

        if aspect < min_aspect or aspect > max_aspect:
            return {
                "valid": False,
                "state": "unknown",
                "confidence": 0.0,
                "reason": f"bad_aspect:aspect={aspect:.2f},bw={bw:.1f},bh={bh:.1f}",
            }

        pad_x = self.tl_env_float_safe("TL_FRONT_PAD_X", 0.12)
        pad_y = self.tl_env_float_safe("TL_FRONT_PAD_Y", 0.12)

        px = bw * pad_x
        py = bh * pad_y

        xx1 = max(0, int(x1 - px))
        yy1 = max(0, int(y1 - py))
        xx2 = min(W, int(x2 + px))
        yy2 = min(H, int(y2 + py))

        crop = frame[yy1:yy2, xx1:xx2]
        if crop.size == 0:
            return {
                "valid": False,
                "state": "unknown",
                "confidence": 0.0,
                "reason": "empty_crop",
            }

        ch, cw = crop.shape[:2]
        crop_area = max(1.0, float(ch * cw))

        hsv = cv2.cvtColor(crop, cv2.COLOR_BGR2HSV)
        h = hsv[:, :, 0]
        sat = hsv[:, :, 1]
        val = hsv[:, :, 2]

        red_s = self.tl_env_float_safe("TL_HSV_RED_MIN_S", 70.0)
        red_v = self.tl_env_float_safe("TL_HSV_RED_MIN_V", 80.0)

        yellow_s = self.tl_env_float_safe("TL_HSV_YELLOW_MIN_S", 70.0)
        yellow_v = self.tl_env_float_safe("TL_HSV_YELLOW_MIN_V", 90.0)

        green_s = self.tl_env_float_safe("TL_HSV_GREEN_MIN_S", 45.0)
        green_v = self.tl_env_float_safe("TL_HSV_GREEN_MIN_V", 70.0)

        red_mask = (
            (((h <= 10) | (h >= 170)) & (sat >= red_s) & (val >= red_v))
        ).astype("uint8")

        yellow_mask = (
            ((h >= 17) & (h <= 42) & (sat >= yellow_s) & (val >= yellow_v))
        ).astype("uint8")

        green_mask = (
            ((h >= 45) & (h <= 100) & (sat >= green_s) & (val >= green_v))
        ).astype("uint8")

        kernel = np.ones((3, 3), np.uint8)
        red_mask = cv2.morphologyEx(red_mask, cv2.MORPH_OPEN, kernel)
        yellow_mask = cv2.morphologyEx(yellow_mask, cv2.MORPH_OPEN, kernel)
        green_mask = cv2.morphologyEx(green_mask, cv2.MORPH_OPEN, kernel)

        dark_v = self.tl_env_float_safe("TL_DARK_MAX_V", 95.0)
        dark_s_max = self.tl_env_float_safe("TL_DARK_MAX_S", 190.0)

        dark_mask = ((val <= dark_v) & (sat <= dark_s_max)).astype("uint8")
        dark_mask = cv2.morphologyEx(dark_mask, cv2.MORPH_OPEN, kernel)

        min_color_blob = self.tl_env_float_safe("TL_MIN_COLOR_BLOB_AREA", 3.0)
        min_dark_blob = self.tl_env_float_safe("TL_MIN_DARK_BLOB_AREA", 4.0)

        red_comps = self.tl_largest_components(red_mask, min_color_blob)
        yellow_comps = self.tl_largest_components(yellow_mask, min_color_blob)
        green_comps = self.tl_largest_components(green_mask, min_color_blob)
        dark_comps_raw = self.tl_largest_components(dark_mask, min_dark_blob)

        dark_lens_comps = []
        for c in dark_comps_raw:
            ar = c["h"] / max(1.0, c["w"])
            ratio = c["area"] / crop_area
            touches = (
                c["x"] <= 1 or
                c["y"] <= 1 or
                c["x"] + c["w"] >= cw - 2 or
                c["y"] + c["h"] >= ch - 2
            )

            if 0.35 <= ar <= 2.80 and 0.002 <= ratio <= 0.30 and not touches:
                dark_lens_comps.append(c)

        min_dark_lenses = int(self.tl_env_float_safe("TL_MIN_DARK_LENS_COUNT", 1.0))

        yellow_pixels = float(yellow_mask.sum())
        red_pixels = float(red_mask.sum())
        green_pixels = float(green_mask.sum())

        yellow_ratio = yellow_pixels / crop_area
        red_ratio = red_pixels / crop_area
        green_ratio = green_pixels / crop_area
        dark_ratio = float(dark_mask.sum()) / crop_area

        max_yellow_body_ratio = self.tl_env_float_safe("TL_MAX_YELLOW_BODY_RATIO", 0.34)

        # CARLA'nın sarı gövdesi/arka yüzü: çok sarı var, koyu lens/panel yok.
        if yellow_ratio >= max_yellow_body_ratio and len(dark_lens_comps) < min_dark_lenses:
            return {
                "valid": False,
                "state": "unknown",
                "confidence": 0.0,
                "reason": (
                    f"yellow_body_no_lens:"
                    f"yellow_ratio={yellow_ratio:.3f},"
                    f"dark_lens={len(dark_lens_comps)},"
                    f"dark_ratio={dark_ratio:.3f}"
                ),
            }

        candidates = []

        def add_color_candidate(name, comps, total_ratio):
            if not comps:
                return

            c = comps[0]
            color_ratio = c["area"] / crop_area
            touches = (
                c["x"] <= 1 or
                c["y"] <= 1 or
                c["x"] + c["w"] >= cw - 2 or
                c["y"] + c["h"] >= ch - 2
            )

            center_x_score = 1.0 - min(1.0, abs(c["cx"] - cw * 0.5) / max(1.0, cw * 0.5))
            center_y_score = 1.0 - min(1.0, abs(c["cy"] - ch * 0.5) / max(1.0, ch * 0.5))

            candidates.append({
                "state": name,
                "area": c["area"],
                "ratio": color_ratio,
                "total_ratio": total_ratio,
                "touches": touches,
                "center_x_score": center_x_score,
                "center_y_score": center_y_score,
                "comp": c,
            })

        add_color_candidate("red", red_comps, red_ratio)
        add_color_candidate("yellow", yellow_comps, yellow_ratio)
        add_color_candidate("green", green_comps, green_ratio)

        if not candidates:
            return {
                "valid": False,
                "state": "unknown",
                "confidence": 0.0,
                "reason": (
                    f"no_color_lens:"
                    f"red={red_pixels:.0f},yellow={yellow_pixels:.0f},green={green_pixels:.0f},"
                    f"dark_lens={len(dark_lens_comps)}"
                ),
            }

        candidates.sort(
            key=lambda c: (
                c["area"],
                c["center_x_score"],
                c["center_y_score"],
            ),
            reverse=True,
        )

        best = candidates[0]

        max_color_ratio = self.tl_env_float_safe("TL_MAX_COLOR_BLOB_RATIO", 0.28)
        if best["ratio"] > max_color_ratio and len(dark_lens_comps) < min_dark_lenses:
            return {
                "valid": False,
                "state": "unknown",
                "confidence": 0.0,
                "reason": (
                    f"color_blob_too_large_without_lens:"
                    f"state={best['state']},ratio={best['ratio']:.3f},"
                    f"dark_lens={len(dark_lens_comps)}"
                ),
            }

        # Sarı gövde çoğu zaman border'a dayanır. Gerçek aktif lens genelde içeridedir.
        if best["state"] == "yellow" and best["touches"] and len(dark_lens_comps) < min_dark_lenses:
            return {
                "valid": False,
                "state": "unknown",
                "confidence": 0.0,
                "reason": (
                    f"yellow_touches_border_without_lens:"
                    f"ratio={best['ratio']:.3f},dark_lens={len(dark_lens_comps)}"
                ),
            }

        if self.tl_env_bool_safe("TL_REQUIRE_DARK_LENS", True):
            if len(dark_lens_comps) < min_dark_lenses:
                return {
                    "valid": False,
                    "state": "unknown",
                    "confidence": 0.0,
                    "reason": (
                        f"no_dark_lens_panel:"
                        f"dark_lens={len(dark_lens_comps)},"
                        f"state={best['state']},"
                        f"color_ratio={best['ratio']:.3f}"
                    ),
                }

        conf = min(1.0, max(0.05, best["area"] / max(1.0, crop_area * 0.025)))

        return {
            "valid": True,
            "state": best["state"],
            "confidence": float(conf),
            "reason": (
                f"front_lens_ok:"
                f"state={best['state']},"
                f"color_ratio={best['ratio']:.3f},"
                f"dark_lens={len(dark_lens_comps)},"
                f"dark_ratio={dark_ratio:.3f},"
                f"yellow_ratio={yellow_ratio:.3f}"
            ),
        }

    def normalize_or_drop_traffic_light_lens(self, frame, det):
        if not isinstance(det, dict):
            return False

        if det.get("label") != "traffic_light":
            return True

        if not self.tl_env_bool_safe("TL_FRONT_LENS_GATE", True):
            return True

        result = self.validate_traffic_light_front_lens(frame, det)

        if not result.get("valid", False):
            det["drop_traffic_light"] = True
            det["drop_traffic_light_reason"] = result.get("reason", "front_lens_invalid")
            det["traffic_light_state"] = "unknown"
            det["traffic_light_state_confidence"] = 0.0
            det["traffic_light_state_source"] = "front_lens_gate_drop"
            return False

        det["drop_traffic_light"] = False
        det["traffic_light_state"] = result.get("state", "unknown")
        det["traffic_light_state_confidence"] = float(result.get("confidence", 0.0))
        det["tl_state_confidence"] = float(result.get("confidence", 0.0))
        det["traffic_light_state_source"] = "front_lens_gate"
        det["traffic_light_color_reason"] = result.get("reason", "front_lens_ok")
        return True

    def draw_detection(self, frame, det):
        if det.get("label") == "traffic_light":
            if not self.normalize_or_drop_traffic_light_lens(frame, det):
                return frame
        if self.is_bad_carla_yellow_body_light(det):
            return frame
        x1, y1, x2, y2 = [int(v) for v in det["bbox"]]

        label = det.get("label", "unknown")
        original_label = det.get("original_label", label)
        conf = float(det.get("confidence", 0.0))

        if self.is_person(label):
            color = (255, 0, 0)
            text = f"person/{original_label} {conf:.2f}"

        elif self.is_vehicle(label):
            color = (0, 255, 0)
            text = f"vehicle/{original_label} {conf:.2f}"

        elif self.is_motorcycle(label):
            color = (255, 0, 255)
            text = f"motorcycle/{original_label} {conf:.2f}"

        elif self.is_traffic_light(label):
            state = det.get("traffic_light_state", "unknown")
            state_conf = det.get("traffic_light_state_confidence", None)

            if state == "red":
                color = (0, 0, 255)
            elif state == "yellow":
                color = (0, 255, 255)
            elif state == "green":
                color = (0, 255, 0)
            else:
                color = (180, 180, 180)

            if state_conf is not None:
                text = f"traffic_light {state} {conf:.2f}/{float(state_conf):.2f}"
            else:
                text = f"traffic_light {state} {conf:.2f}"

        elif self.is_traffic_sign(label):
            color = (0, 255, 255)
            sign_type = det.get("sign_type", "unknown")
            sign_name = self.pretty_sign_name(sign_type)

            if sign_type != "unknown":
                text = f"LEVHA: {sign_name} {conf:.2f}"
            else:
                text = f"traffic_sign/{original_label} {conf:.2f}"

        else:
            color = (255, 255, 255)
            text = f"{label}/{original_label} {conf:.2f}"

        cv2.rectangle(frame, (x1, y1), (x2, y2), color, 2)

        font = cv2.FONT_HERSHEY_SIMPLEX
        font_scale = 0.50
        font_thickness = 2

        (tw, th), _ = cv2.getTextSize(text, font, font_scale, font_thickness)

        tx1 = max(0, x1)
        ty1 = max(0, y1 - th - 8)
        tx2 = min(frame.shape[1] - 1, x1 + tw + 8)
        ty2 = max(0, y1)

        cv2.rectangle(frame, (tx1, ty1), (tx2, ty2), color, -1)

        cv2.putText(
            frame,
            text,
            (x1 + 4, max(15, y1 - 6)),
            font,
            font_scale,
            (0, 0, 0),
            font_thickness,
            cv2.LINE_AA,
        )

    def draw_text(self, frame, text, x, y, color=(255, 255, 255), scale=0.55, thickness=2):
        cv2.putText(
            frame,
            str(text),
            (x, y),
            cv2.FONT_HERSHEY_SIMPLEX,
            scale,
            color,
            thickness,
            cv2.LINE_AA,
        )

    def make_debug_canvas(self, frame, detections):
        h, w = frame.shape[:2]
        panel_w = 430

        canvas = cv2.copyMakeBorder(
            frame,
            0,
            0,
            0,
            panel_w,
            cv2.BORDER_CONSTANT,
            value=(45, 45, 45),
        )

        px = w + 20

        vehicles = len([d for d in detections if d.get("label") == "vehicle"])
        persons = len([d for d in detections if d.get("label") == "person"])
        motorcycles = len([d for d in detections if d.get("label") == "motorcycle"])
        traffic_lights = len([d for d in detections if d.get("label") == "traffic_light"])
        traffic_signs = len([d for d in detections if d.get("label") == "traffic_sign"])

        others = len([
            d for d in detections
            if d.get("label") not in [
                "vehicle",
                "person",
                "motorcycle",
                "traffic_light",
                "traffic_sign",
            ]
        ])

        light_states = [
            d.get("traffic_light_state", "unknown")
            for d in detections
            if d.get("label") == "traffic_light"
        ]

        sign_names = [
            self.pretty_sign_name(d.get("sign_type", "unknown"))
            for d in detections
            if d.get("label") == "traffic_sign"
        ]

        light_text = ",".join(light_states[:5]) if light_states else "-"
        sign_text = ",".join(sign_names[:5]) if sign_names else "-"

        self.draw_text(canvas, "ADAS PERCEPTION", px, 35, (255, 255, 255), 0.70, 2)
        self.draw_text(canvas, "YOLO + TL STATE CLASSIFIER", px, 65, (0, 255, 255), 0.48, 2)

        self.draw_text(canvas, f"Model imgsz   : {self.imgsz}", px, 105)
        self.draw_text(canvas, f"Raw Conf      : {self.raw_conf_threshold:.3f}", px, 132)
        self.draw_text(canvas, f"Person Conf   : {self.person_conf_threshold:.3f}", px, 159)
        self.draw_text(canvas, f"Vehicle Conf  : {self.vehicle_conf_threshold:.2f}", px, 186)
        self.draw_text(canvas, f"Motor Conf    : {self.motorcycle_conf_threshold:.2f}", px, 213)
        self.draw_text(canvas, f"Light Conf    : {self.traffic_light_conf_threshold:.2f}", px, 240)
        self.draw_text(canvas, f"TL State Thr  : {self.tl_state_conf_threshold:.2f}", px, 267)
        self.draw_text(canvas, f"TL Cls Ready  : {self.tl_state_ready}", px, 294)

        cv2.line(canvas, (w + 15, 320), (w + panel_w - 15, 320), (100, 100, 100), 1)

        self.draw_text(canvas, "DETECTIONS", px, 355, (200, 200, 200), 0.60, 2)
        self.draw_text(canvas, f"Vehicles      : {vehicles}", px, 392)
        self.draw_text(canvas, f"Persons       : {persons}", px, 419)
        self.draw_text(canvas, f"Motorcycles   : {motorcycles}", px, 446)
        self.draw_text(canvas, f"TrafficLight  : {traffic_lights}", px, 473)
        self.draw_text(canvas, f"TrafficSign   : {traffic_signs}", px, 500)
        self.draw_text(canvas, f"Others        : {others}", px, 527)

        cv2.line(canvas, (w + 15, 555), (w + panel_w - 15, 555), (100, 100, 100), 1)

        self.draw_text(canvas, "MODEL OUTPUT", px, 590, (200, 200, 200), 0.60, 2)
        self.draw_text(canvas, f"Light State   : {light_text}", px, 625)
        self.draw_text(canvas, f"Signs         : {sign_text}", px, 655, (255, 255, 255), 0.45, 1)

        y = 690
        for det in detections[:7]:
            label = det.get("label", "-")
            original = det.get("original_label", "-")
            conf = float(det.get("confidence", 0.0))

            if label == "traffic_light":
                state = det.get("traffic_light_state", "unknown")
                source = det.get("traffic_light_state_source", "-")
                state_conf = det.get("traffic_light_state_confidence", None)
                hsv_state = det.get("traffic_light_hsv_state", "-")
                probs = det.get("traffic_light_state_probs", {})
                reason = det.get("traffic_light_color_reason", "-")

                state_conf_text = "-" if state_conf is None else f"{float(state_conf):.2f}"
                p_red = float(probs.get("red", 0.0))
                p_yellow = float(probs.get("yellow", 0.0))
                p_green = float(probs.get("green", 0.0))
                p_unknown = float(probs.get("unknown", 0.0))

                line = f"TL {state} det={conf:.2f} cls={state_conf_text} src={source[:12]}"
                self.draw_text(canvas, line, px, y, (255, 255, 255), 0.32, 1)
                y += 18

                line2 = f"P R{p_red:.2f} Y{p_yellow:.2f} G{p_green:.2f} U{p_unknown:.2f} HSV={hsv_state}"
                self.draw_text(canvas, line2, px, y, (220, 220, 220), 0.29, 1)
                y += 18

                self.draw_text(canvas, f"reason: {str(reason)[:36]}", px, y, (220, 220, 220), 0.28, 1)
                y += 22

            else:
                line = f"{label}/{original} {conf:.2f}"
                self.draw_text(canvas, line, px, y, (255, 255, 255), 0.36, 1)
                y += 22

        return canvas

    def image_callback(self, msg):
        try:
            frame = self.bridge.imgmsg_to_cv2(msg, desired_encoding="bgr8")
        except Exception as exc:
            self.get_logger().error(f"cv_bridge hata: {exc}")
            return

        frame_h, frame_w = frame.shape[:2]
        annotated = frame.copy()

        detections = []

        try:
            results = self.model.predict(
                source=frame,
                conf=self.raw_conf_threshold,
                iou=self.iou_threshold,
                imgsz=self.imgsz,
                max_det=self.max_det,
                verbose=False,
            )
        except Exception as exc:
            self.get_logger().error(f"YOLO predict hata: {exc}")
            return

        if len(results) > 0:
            result = results[0]

            if result.boxes is not None:
                for box in result.boxes:
                    cls_id = int(box.cls[0].item())
                    conf = float(box.conf[0].item())
                    x1, y1, x2, y2 = box.xyxy[0].tolist()

                    original_label = self.get_yolo_name(cls_id)
                    label = self.normalize_label(original_label)

                    class_threshold = self.get_class_threshold(label)

                    if conf < class_threshold:
                        self.get_logger().info(
                            f"FILTERED_LOW_CONF "
                            f"class_id={cls_id} "
                            f"original={original_label} "
                            f"mapped_label={label} "
                            f"conf={conf:.3f} "
                            f"required={class_threshold:.3f}",
                            throttle_duration_sec=0.5,
                        )
                        continue

                    bbox_w = max(1.0, float(x2 - x1))
                    bbox_h = max(1.0, float(y2 - y1))
                    area_ratio = (bbox_w * bbox_h) / float(frame_w * frame_h)

                    det = {
                        "class_id": cls_id,
                        "label": label,
                        "original_label": original_label,
                        "confidence": conf,
                        "bbox": [
                            float(x1),
                            float(y1),
                            float(x2),
                            float(y2),
                        ],
                        "center_x": float((x1 + x2) / 2.0),
                        "center_y": float((y1 + y2) / 2.0),
                        "bbox_width": float(bbox_w),
                        "bbox_height": float(bbox_h),
                        "area_ratio": float(area_ratio),
                        "source": "model_only_yolo",
                    }

                    if label == "traffic_light":
                        light_result = self.classify_traffic_light_state(
                            frame,
                            det["bbox"],
                        )

                        det["traffic_light_state"] = light_result["state"]
                        det["traffic_light_state_source"] = light_result["source"]
                        det["traffic_light_state_confidence"] = light_result["state_confidence"]
                        det["traffic_light_state_probs"] = light_result["classifier_probs"]
                        det["traffic_light_state_classifier_reason"] = light_result["classifier_reason"]

                        det["traffic_light_hsv_state"] = light_result["hsv_state"]
                        det["traffic_light_color_source"] = light_result["source"]
                        det["traffic_light_color_scores"] = light_result["hsv_scores"]
                        det["traffic_light_color_reason"] = light_result["final_reason"]
                        det["traffic_light_hsv_reason"] = light_result["hsv_reason"]

                    if label == "traffic_sign":
                        sign_type = self.get_sign_type_from_label(original_label)
                        det["sign_type"] = sign_type
                        det["sign_name"] = self.pretty_sign_name(sign_type)
                        det["sign_confidence"] = conf

                    detections.append(det)

                    model_name = (
                        self.model.names.get(cls_id, str(cls_id))
                        if isinstance(self.model.names, dict)
                        else self.model.names[cls_id]
                    )

                    if label == "traffic_light":
                        self.get_logger().info(
                            f"MODEL_DET "
                            f"class_id={cls_id} "
                            f"model_name={model_name} "
                            f"original={original_label} "
                            f"mapped_label={label} "
                            f"conf={conf:.3f} "
                            f"state={det.get('traffic_light_state')} "
                            f"state_conf={det.get('traffic_light_state_confidence')} "
                            f"state_source={det.get('traffic_light_state_source')} "
                            f"probs={det.get('traffic_light_state_probs')} "
                            f"hsv_state={det.get('traffic_light_hsv_state')} "
                            f"hsv_scores={det.get('traffic_light_color_scores')} "
                            f"reason={det.get('traffic_light_color_reason')} "
                            f"bbox={[round(float(v), 1) for v in det['bbox']]}",
                            throttle_duration_sec=0.3,
                        )
                    else:
                        self.get_logger().info(
                            f"MODEL_DET "
                            f"class_id={cls_id} "
                            f"model_name={model_name} "
                            f"original={original_label} "
                            f"mapped_label={label} "
                            f"conf={conf:.3f} "
                            f"bbox={[round(float(v), 1) for v in det['bbox']]}",
                            throttle_duration_sec=0.3,
                        )

        self.apply_lens_hsv_to_traffic_lights(frame, detections)

        detections = [d for d in detections if not self.is_bad_carla_yellow_body_light(d)]

        if self.tl_env_bool_safe("TL_FRONT_LENS_GATE", True):
            _tl_before = sum(1 for _d in detections if _d.get("label") == "traffic_light")
            _filtered = []
            _drop_reasons = []

            for _d in detections:
                if _d.get("label") == "traffic_light":
                    if not self.normalize_or_drop_traffic_light_lens(frame, _d):
                        _drop_reasons.append(_d.get("drop_traffic_light_reason", "front_lens_invalid"))
                        continue

                _filtered.append(_d)

            detections = _filtered
            _tl_after = sum(1 for _d in detections if _d.get("label") == "traffic_light")

            if _tl_before != _tl_after:
                self.get_logger().info(
                    f"FINAL_TL_FRONT_LENS_GATE before={_tl_before} after={_tl_after} reasons={_drop_reasons[:4]}",
                    throttle_duration_sec=0.5,
                )

        active_light_state = "unknown"
        active_light_confidence = None
        active_light_color_scores = None
        active_light_color_reason = None
        active_light_state_confidence = None
        active_light_state_source = None
        active_light_state_probs = None
        active_light_bbox = None

        active_light = self.choose_active_traffic_light(detections, frame_w, frame_h, frame)

        for det in detections:
            if det.get("label") == "traffic_light":
                det["active_traffic_light"] = False

        if active_light is not None:
            active_light["active_traffic_light"] = True

            active_light_state = active_light.get("traffic_light_state", "unknown")
            active_light_confidence = float(active_light.get("confidence", 0.0))
            active_light_color_scores = active_light.get("traffic_light_color_scores", None)
            active_light_color_reason = active_light.get("traffic_light_color_reason", None)
            active_light_state_confidence = self.get_tl_state_confidence(active_light)
            active_light_state_source = active_light.get("traffic_light_state_source", active_light.get("state_source", None))
            active_light_state_probs = active_light.get("traffic_light_state_probs", active_light.get("tl_state_probs", None))
            active_light_bbox = active_light.get("bbox", None)

            keep_only_active = False  # TEST: valid traffic lights were being dropped by active-light filter

            if False and keep_only_active:
                detections = [
                    d for d in detections
                    if d.get("label") != "traffic_light"
                ] + [active_light]

                detections = sorted(
                    detections,
                    key=lambda d: (
                        1 if d.get("active_traffic_light", False) else 0,
                        float(d.get("confidence", 0.0)),
                    ),
                    reverse=True,
                )

            self.get_logger().info(
                f"ACTIVE_TRAFFIC_LIGHT "
                f"state={active_light_state} "
                f"det_conf={active_light_confidence:.3f} "
                f"state_conf={active_light_state_confidence:.3f} "
                f"bbox={[round(float(v), 1) for v in active_light.get('bbox', [])]}",
                throttle_duration_sec=0.5,
            )

        for det in detections:
            if det.get("label") == "traffic_light":
                det["active_traffic_light"] = False

        if active_light is not None:
            active_light["active_traffic_light"] = True

            active_light_state = active_light.get("traffic_light_state", "unknown")
            active_light_confidence = float(active_light.get("confidence", 0.0))
            active_light_color_scores = active_light.get("traffic_light_color_scores", None)
            active_light_color_reason = active_light.get("traffic_light_color_reason", None)

            keep_only_active = False  # TEST: valid traffic lights were being dropped by active-light filter

            if False and keep_only_active:
                detections = [
                    d for d in detections
                    if d.get("label") != "traffic_light"
                ] + [active_light]

                detections = sorted(
                    detections,
                    key=lambda d: (
                        1 if d.get("active_traffic_light", False) else 0,
                        float(d.get("confidence", 0.0)),
                    ),
                    reverse=True,
                )

            self.get_logger().info(
                f"ACTIVE_TRAFFIC_LIGHT "
                f"state={active_light_state} "
                f"det_conf={active_light_confidence:.3f} "
                f"state_conf={self.get_tl_state_confidence(active_light):.3f} "
                f"bbox={[round(float(v), 1) for v in active_light.get('bbox', [])]}",
                throttle_duration_sec=0.5,
            )

        if False and (active_light is None and env_bool("TL_KEEP_ONLY_ACTIVE", True)):
            rejected_lights = [
                d for d in detections
                if d.get("label") == "traffic_light"
            ]

            if rejected_lights:
                self.get_logger().info(
                    f"DROP_INACTIVE_TRAFFIC_LIGHTS count={len(rejected_lights)} "
                    f"reasons={[d.get('active_reject_reason', '-') for d in rejected_lights[:5]]}",
                    throttle_duration_sec=0.5,
                )

            detections = [
                d for d in detections
                if d.get("label") != "traffic_light"
            ]

        for det in detections:
            self.draw_detection(annotated, det)

        debug_canvas = self.make_debug_canvas(annotated, detections)

        payload = {
            "stamp": time.time(),
            "image_width": frame_w,
            "image_height": frame_h,
            "model_path": self.model_path,
            "model_only": True,
            "raw_conf_threshold": self.raw_conf_threshold,
            "person_conf_threshold": self.person_conf_threshold,
            "vehicle_conf_threshold": self.vehicle_conf_threshold,
            "motorcycle_conf_threshold": self.motorcycle_conf_threshold,
            "traffic_light_conf_threshold": self.traffic_light_conf_threshold,
            "traffic_sign_conf_threshold": self.traffic_sign_conf_threshold,
            "iou_threshold": self.iou_threshold,
            "imgsz": self.imgsz,
            "max_det": self.max_det,

            "traffic_light_state_classifier_enabled": self.tl_state_classifier_enabled,
            "traffic_light_state_classifier_ready": self.tl_state_ready,
            "traffic_light_state_model_path": self.tl_state_model_path,
            "traffic_light_state_conf_threshold": self.tl_state_conf_threshold,

            "detections": detections,

            "traffic_light_state": active_light_state,
            "traffic_light_confidence": active_light_confidence,
            "traffic_light_state_confidence": active_light_state_confidence,
            "traffic_light_state_source": active_light_state_source,
            "traffic_light_state_probs": active_light_state_probs,
            "traffic_light_color_scores": active_light_color_scores,
            "traffic_light_color_reason": active_light_color_reason,
        }

        msg_out = String()
        msg_out.data = json.dumps(payload, ensure_ascii=False)
        self.det_pub.publish(msg_out)

        try:
            annotated_msg = self.bridge.cv2_to_imgmsg(debug_canvas, encoding="bgr8")
            annotated_msg.header = msg.header
            self.annotated_pub.publish(annotated_msg)
        except Exception as exc:
            self.get_logger().error(f"annotated image publish hata: {exc}")

        if self.show_debug:
            cv2.imshow(self.window_name, debug_canvas)
            cv2.waitKey(1)


def main(args=None):
    rclpy.init(args=args)
    node = PerceptionNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node.show_debug:
            cv2.destroyAllWindows()

        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
