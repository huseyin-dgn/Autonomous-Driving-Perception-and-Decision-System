<?xml version="1.0"?>
<sdf version="1.9">
  <model name="traffic_light_green_model">
    <static>true</static>

    <link name="traffic_light_link">

      <visual name="pole_visual">
        <pose>0 0 1.4 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>2.8</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <visual name="box_visual">
        <pose>0 0 2.9 0 0 0</pose>
        <geometry>
          <box>
            <size>0.45 0.18 0.95</size>
          </box>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.01 0.01 0.01 1</diffuse>
        </material>
      </visual>

      <visual name="red_light_off">
        <pose>-0.23 0 3.20 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.02 0.02 1</ambient>
          <diffuse>0.08 0.02 0.02 1</diffuse>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <visual name="yellow_light_off">
        <pose>-0.23 0 2.90 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.02 1</ambient>
          <diffuse>0.08 0.08 0.02 1</diffuse>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <visual name="green_light_on">
        <pose>-0.23 0 2.60 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
          <emissive>0 1 0 1</emissive>
        </material>
      </visual>

      <collision name="traffic_light_collision">
        <pose>0 0 1.6 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.25 3.2</size>
          </box>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
