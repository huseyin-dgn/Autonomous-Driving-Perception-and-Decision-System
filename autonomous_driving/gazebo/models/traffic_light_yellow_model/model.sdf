<?xml version="1.0"?>
<sdf version="1.9">
  <model name="traffic_light_yellow_model">
    <static>true</static>
    <link name="traffic_light_link">
      <collision name="pole_collision">
        <pose>0 0 1.25 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>2.5</length></cylinder></geometry>
      </collision>
      <visual name="pole_visual">
        <pose>0 0 1.25 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>2.5</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>

      <collision name="housing_collision">
        <pose>0 0 3.0 0 0 0</pose>
        <geometry><box><size>0.35 0.75 1.75</size></box></geometry>
      </collision>
      <visual name="housing_visual">
        <pose>0 0 3.0 0 0 0</pose>
        <geometry><box><size>0.35 0.75 1.75</size></box></geometry>
        <material><ambient>0.01 0.01 0.01 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse></material>
      </visual>

      <visual name="red_lamp_visual">
        <pose>-0.20 0 3.55 0 0 0</pose>
        <geometry><sphere><radius>0.23</radius></sphere></geometry>
        <material><ambient>0.18 0.02 0.02 1</ambient><diffuse>0.18 0.02 0.02 1</diffuse><emissive>0 0 0 1</emissive></material>
      </visual>
      <visual name="yellow_lamp_visual">
        <pose>-0.20 0 3.00 0 0 0</pose>
        <geometry><sphere><radius>0.23</radius></sphere></geometry>
        <material><ambient>1 0.78 0.02 1</ambient><diffuse>1 0.78 0.02 1</diffuse><emissive>1 0.55 0 1</emissive></material>
      </visual>
      <visual name="green_lamp_visual">
        <pose>-0.20 0 2.45 0 0 0</pose>
        <geometry><sphere><radius>0.23</radius></sphere></geometry>
        <material><ambient>0.02 0.16 0.04 1</ambient><diffuse>0.02 0.16 0.04 1</diffuse><emissive>0 0 0 1</emissive></material>
      </visual>
    </link>
  </model>
</sdf>
