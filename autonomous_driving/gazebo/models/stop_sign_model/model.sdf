<?xml version="1.0"?>
<sdf version="1.9">
  <model name="stop_sign_model">
    <static>true</static>

    <link name="stop_sign_link">

      <visual name="pole_visual">
        <pose>0 0 1.15 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>2.3</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.45 1</ambient>
          <diffuse>0.45 0.45 0.45 1</diffuse>
        </material>
      </visual>

      <visual name="sign_board">
        <pose>-0.08 0 2.45 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.04</length>
            <segments>8</segments>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <emissive>0.3 0 0 1</emissive>
        </material>
      </visual>

      <visual name="sign_center_white">
        <pose>-0.105 0 2.45 0 1.5708 0</pose>
        <geometry>
          <box>
            <size>0.015 0.45 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.4 0.4 0.4 1</emissive>
        </material>
      </visual>

      <collision name="stop_sign_collision">
        <pose>0 0 1.4 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.5 2.8</size>
          </box>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
